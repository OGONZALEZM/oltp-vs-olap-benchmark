# Optional Socrata app token (avoids anonymous throttling).
SOCRATA_APP_TOKEN=

# Ingestion window, YYYY-MM, inclusive. CLI flags --start/--end take precedence.
INGEST_START_MONTH=2025-01
INGEST_END_MONTH=2025-06

# Postgres for configs A and B (docker-compose.yml publishes on 5433 by default).
DATABASE_URL=postgres://bench:bench@localhost:5433/bench
PG_PORT=5433
